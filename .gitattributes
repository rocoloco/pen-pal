# These files cross an scp boundary onto the Scribe and the host. With
# core.autocrlf=true and no attributes, a checkout rewrites them with CRLF in the
# working tree: the Scribe's busybox then reports "not found" for a script whose
# own interpreter line ends in \r, and the python service ships that byte to the
# host. Pin them to LF in the index and the working tree.
*.sh      text eol=lf
*.py      text eol=lf
*.c       text eol=lf
*.h       text eol=lf
*.mjs     text eol=lf
*.service text eol=lf
*.timer   text eol=lf
*.conf    text eol=lf
*.yml     text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.wire    text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf
NOTICE text eol=lf
*.txt text eol=lf
*.ttf binary
